#!/usr/bin/env bash
# ==============================================================================
# DUCK PROXY — MINIMALIST UBER-STYLE CLI LAUNCHER & SHORTCUT
# ==============================================================================

set -e

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN_PATH="$REPO_DIR/duck-proxy-rs/target/release/duck-proxy-rs"
CONFIG_PATH="$REPO_DIR/duck-proxy-rs/config.yaml"
APP_URL="http://localhost:8080/app"
PORT=8080

# Build release binary if missing
if [ ! -f "$BIN_PATH" ]; then
    echo "⚙️ Building duck-proxy-rs (release mode)..."
    cargo build --release --manifest-path "$REPO_DIR/duck-proxy-rs/Cargo.toml"
fi

# Check if proxy is already running on port 8080
if lsof -Pi :$PORT -sTCP:LISTEN -t >/dev/null 2>&1 || nc -z 127.0.0.1 $PORT 2>/dev/null; then
    STATUS_LINE="🟢 Duck Proxy is active on http://127.0.0.1:$PORT"
else
    echo "🚀 Starting Duck Proxy on http://127.0.0.1:$PORT..."
    setsid "$BIN_PATH" "$CONFIG_PATH" > /tmp/duck-proxy.log 2>&1 &
    PROXY_PID=$!
    
    # Wait for server to become responsive
    for i in {1..30}; do
        if curl -s http://127.0.0.1:$PORT/v1/models >/dev/null 2>&1; then
            break
        fi
        sleep 0.1
    done
    STATUS_LINE="✅ Duck Proxy started (PID: $PROXY_PID)"
fi

# Open Dashboard in default web browser
if which xdg-open > /dev/null 2>&1; then
    xdg-open "$APP_URL" > /dev/null 2>&1 &
elif which open > /dev/null 2>&1; then
    open "$APP_URL" > /dev/null 2>&1 &
fi

cat << "EOF"

 ┌──────────────────────────────────────────────────────────────┐
 │  DUCK // PROXY — Local AI Gateway (OpenAI Compatible)        │
 └──────────────────────────────────────────────────────────────┘

  ● Base URL:    http://localhost:8080/v1
  ● API Key:     duck-proxy  (or any arbitrary key)
  ● Dashboard:   http://localhost:8080/app
  ● Status:      ONLINE  (Port 8080)

 ────────────────────────────────────────────────────────────────
  MODELS:
   • gpt5        → OpenAI GPT-5.6 Luna (Deep Coding & Reasoning)
   • claude      → Anthropic Claude Haiku 4.5 (Fast Code Edits)
   • mistral     → Mistral Small 2603 (Logic & Math)
   • gemma       → Google / Tinfoil Gemma 4 (Privacy-Preserved)
   • image       → Diffusion Image Generation

 ────────────────────────────────────────────────────────────────
  QUICK USAGE:
   • Test API:   curl http://localhost:8080/v1/models
   • Quick Chat: curl http://localhost:8080/v1/chat/completions \
                   -H "Content-Type: application/json" \
                   -d '{"model":"gpt5","messages":[{"role":"user","content":"Hi"}]}'
   • IDE Setup:  See full Cursor, VS Code, Zed, Aider configs at /app
   • Live Logs:  tail -f /tmp/duck-proxy.log
 ────────────────────────────────────────────────────────────────

EOF
